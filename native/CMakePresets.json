{
  "version": 2,
  "configurePresets": [
    {
      "name": "release",
      "hidden": true,
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "macos",
      "inherits": "release",
      "binaryDir": "${sourceDir}/../build/native"
    },
    {
      "name": "linux-x86_64",
      "inherits": "release",
      "binaryDir": "${sourceDir}/../build/native-linux-x86_64",
      "cacheVariables": {
        "SPINDLE_EXPECT_ARCH": "x86_64"
      }
    },
    {
      "name": "linux-arm64",
      "inherits": "release",
      "binaryDir": "${sourceDir}/../build/native-linux-arm64",
      "cacheVariables": {
        "SPINDLE_EXPECT_ARCH": "arm64"
      }
    },
    {
      "name": "windows-x86_64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/../build/native-windows-x86_64",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "SPINDLE_EXPECT_ARCH": "x86_64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos",
      "configurePreset": "macos",
      "jobs": 4
    },
    {
      "name": "linux-x86_64",
      "configurePreset": "linux-x86_64",
      "jobs": 4
    },
    {
      "name": "linux-arm64",
      "configurePreset": "linux-arm64",
      "jobs": 4
    },
    {
      "name": "windows-x86_64",
      "configurePreset": "windows-x86_64",
      "configuration": "Release",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "macos",
      "configurePreset": "macos",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-x86_64",
      "configurePreset": "linux-x86_64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-arm64",
      "configurePreset": "linux-arm64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x86_64",
      "configurePreset": "windows-x86_64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
